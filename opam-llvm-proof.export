    "js_of_ocaml-compiler" {< "5.5.0"}
    "fmt" {< "0.9.0"}
  ]
  build: [
    "ocaml"
    "pkg/pkg.ml"
    "build"
    "--dev-pkg"
    "%{dev}%"
    "--with-js_of_ocaml-compiler"
    "%{js_of_ocaml-compiler:installed}%"
    "--with-fmt"
