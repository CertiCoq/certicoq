    "ppx_optcomp"
    "ocaml-lsp-server" {with-dev-setup}
    "odoc" {with-doc}
    "rocq-stdlib" {with-doc}
  ]
  build: [
    ["dune" "subst"] {dev}
    [
      "etc/with-rocq-wrap.sh" {!coq-core:installed}
      "dune"
      "build"
      "-p"
      name
      "-j"
      jobs
      "@install"
      "@runtest" {with-test}
      "@doc" {with-doc}
    ]
  ]
  dev-repo: "git+https://github.com/LPCIC/coq-elpi.git"
  url {
