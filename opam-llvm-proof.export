      "https://github.com/math-comp/math-comp/archive/mathcomp-2.4.0.tar.gz"
    checksum:
      "sha256=6307218d7e434fb6ffc81b9275c673d3f7f1f4884ad59b904abd205c437021a0"
  }
}
